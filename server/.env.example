# Web Push 后端配置示例。复制为 server/.env 后按需修改。
# 说明：pm2 / shell 传入的同名环境变量优先于本文件（dotenv 不覆盖已存在的变量）。

# 输出根目录（与 Python 端 weather_common.default_output_root 一致）。
# 不设置则按平台默认：Linux 生产 = /data/weather_vis，Windows 本地 = <repo>/data。
WEATHER_OUTPUT_ROOT=/data/weather_vis

# SVG 产品根目录（轮询在此探测最新起报时次的 manifest.json）。默认 <output_root>/products。
WEATHER_PRODUCTS_ROOT=/data/weather_vis/products

# 推送状态目录（VAPID 密钥 / 订阅 / 去重标记）。默认 <output_root>/push。
WEATHER_PUSH_ROOT=/data/weather_vis/push

# VAPID 声明的 sub：mailto: 或 https: URL。务必改成真实联系方式（部分推送服务会校验）。
WEATHER_VAPID_SUBJECT=mailto:admin@your-domain

# 订阅服务监听端口（nginx 反代 /api/ 到此端口）。默认 8090。
WEATHER_PUSH_PORT=8090
